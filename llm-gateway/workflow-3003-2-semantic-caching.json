    {
      "parameters": {
        "jsCode": "// CONCEPT 2: SEMANTIC & PROMPT CACHE LOOKUP\nconst item = ($input.first() && $input.first().json) ? $input.first().json : {};\nconst rawPrompt = item.chatInput || item.message || item.prompt || 'What are the core benefits of microservices?';\nconst normalizedPrompt = rawPrompt.trim().toLowerCase();\nconst cacheKey = 'cache_' + Buffer.from(normalizedPrompt).toString('base64');\n\nif (!global.gatewayCacheStore) {\n  global.gatewayCacheStore = {\n    'cache_d2hhdCBhcmUgdGhlIGNvcmUgYmVuZWZpdHMgb2YgbWljcm9zZXJ2aWNlcz8=': 'Microservices architecture offers independent scalability, fault isolation, and technology flexibility.',\n    'what are the core benefits of microservices?': 'Microservices architecture offers independent scalability, fault isolation, and technology flexibility.'\n  };\n}\n\nconst cachedResponse = global.gatewayCacheStore[cacheKey] || global.gatewayCacheStore[normalizedPrompt] || null;\nconst cacheHit = !!cachedResponse;\n\nif (cacheHit) {\n  return {\n    json: {\n      output: `⚡ [CACHE HIT - 0 Cost, 3ms Latency]\\nResponse: \"${cachedResponse}\"\\nCache Key: ${cacheKey}`,\n      cacheHit: true,\n      rawPrompt,\n      cachedResponse,\n      modelUsed: 'semantic-cache-v1',\n      latencyMs: 3,\n      costUsd: 0.0\n    }\n  };\n} else {\n  return {\n    json: {\n      output: `❌ [CACHE MISS - Forwarding to Azure OpenAI LLM Model]\\nQuery: \"${rawPrompt}\"`,\n      cacheHit: false,\n      rawPrompt,\n      chatInput: rawPrompt,\n      cacheKey\n    }\n  };\n}"
      },
      "id": "step-2-cache-check",
      "name": "Step 2: Semantic Cache Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
